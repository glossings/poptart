{
  "name": "poptart",
  "private": true,
  "version": "0.1.0",
  "description": "A Strudel-flavored livecoding environment that hosts real VST/AU plugins as instruments and effects, with continuous parameter modulation.",
  "workspaces": [
    "packages/osc-engine",
    "packages/pattern-core",
    "packages/web-app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace packages/web-app",
    "test": "npm run test --workspaces --if-present",
    "doctor": "node packages/osc-engine/doctor.js",
    "desktop": "node packages/desktop/start.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only"
}
