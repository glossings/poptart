{
  "name": "poptart",
  "private": true,
  "version": "0.1.1",
  "description": "A Strudel-flavored livecoding environment that hosts real VST/VST3 plugins as instruments and effects, with continuous parameter modulation.",
  "author": "Glossing",
  "workspaces": [
    "packages/osc-engine",
    "packages/pattern-core",
    "packages/web-app",
    "packages/web-engine"
  ],
  "scripts": {
    "dev": "npm run dev --workspace packages/web-app",
    "test": "npm run test --workspaces --if-present",
    "doctor": "node packages/osc-engine/doctor.js",
    "desktop": "node packages/desktop/start.js",
    "release": "node packages/desktop/release.js",
    "build:web": "node packages/web-app/build-web.mjs",
    "web": "node packages/web-app/serve-web.mjs"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "@serialport/bindings-cpp": false
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only"
}
