node_modules/
dist/
build/
# ...except electron-builder's, which is source: the signing entitlements and (later) the app
# icons live in a folder it expects to be called `build`.
!packages/desktop/build/
# The app folder packages/desktop/stage.js assembles for electron-builder; rebuilt on every run.
packages/desktop/stage/
*.node
.DS_Store
packages/native-engine/build/
packages/native-engine/.cmake-js/
*.log
.cache/

tmp/

# A data folder kept with the checkout instead of in ~/.poptart (osc-engine/home.js): somebody's
# songs, settings and a SuperCollider install - never the repository's business.
poptart-data/

# Local userland hotkey repro - paste into ~/.poptart/prebake.js; not part of the repo
packages/web-app/prebake.hotkeys.js

# Rubber Band + SC headers fetched by native/rubberband/build.sh
packages/osc-engine/native/rubberband/.deps/

# Ableton Link SDK + asio fetched by native/link/build.sh
packages/osc-engine/native/link/.deps/
