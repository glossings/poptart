{
  "name": "@poptart/desktop",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell: runs the web-app server as a child process and points a window at it. Packaging target for the dmg/exe builds. Deliberately outside the npm workspaces - see README.md.",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "test": "node --test",
    "pack": "node stage.js && electron-builder --dir --config electron-builder.yml",
    "dist": "node stage.js && electron-builder --config electron-builder.yml",
    "stage": "node stage.js"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@44.4.3": true
  }
}
