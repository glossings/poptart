<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the signed macOS build. These match what SuperCollider's own Developer-ID
  signed sclang and scsynth carry, because the app does the same things they do.

  disable-library-validation is the load-bearing one: scsynth loads third-party VST and AU
  plugins, which are code signed by other teams (or not at all). Without it a hardened-runtime
  scsynth refuses to load any of them, which is the entire purpose of poptart.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
</dict>
</plist>
